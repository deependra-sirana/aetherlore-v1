# ====================================================================
# Secure AI Game Narrative Generator - Environment Configuration
# ====================================================================
# SECURITY NOTICE:
# - NEVER commit .env or .env.local containing real secrets to Git.
# - The API keys below are SERVER-SIDE ONLY and are NEVER exposed to the browser client.
# ====================================================================

# Google Gemini API Key (Recommended, Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative / Fallback Provider: OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# AI Provider Selection: 'gemini' | 'openai' | 'auto' (default: 'auto')
AI_PROVIDER=auto

# Rate Limiting Configuration (Per IP window)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
